{
  "version": 2,
  "builds": [
    {
      "src": "api/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/regis",
      "destination": "/api/index.go"
    },
    {
      "source": "/login",
      "destination": "/api/index.go"
    },
    {
      "source": "/logout",
      "destination": "/api/index.go"
    },
    {
      "source": "/tes",
      "destination": "/api/index.go"
    },
    {
      "source": "/user",
      "destination": "/api/index.go"
    },
    {
      "source": "/user/:path*",
      "destination": "/api/index.go"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.go"
    },
    {
      "source": "/((?!api|user|regis|login|logout|tes|assets|favicon.svg|icons.svg).*)",
      "destination": "/dist/index.html"
    }
  ]
}
